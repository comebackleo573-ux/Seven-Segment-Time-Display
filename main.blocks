  const dayName = getDayOfWeek(browserEvents.getDayOfWeek(time));" line20="    const monthName = getMonth(browserEvents.getMonth(time));" line21="    const dateNum = formatNumber(browserEvents.getDayOfMonth(time));" line22="    const yearNum = browserEvents.getYear(time) + &quot;&quot;;" line23="" line24="    screen.printCenter(`${dayName}, ${monthName} ${dateNum}`, 95, 15)" line25="    screen.printCenter(yearNum, 107, 15)" line26="});" numlines="27"></mutation></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></statement></block><block type="function_definition" id="$K./~g2Y+^XUh}$peJuv" x="902" y="-3"><mutation name="getDayOfWeek" functionid="Jfd1_7zNH)YN=ai]0~DX"><arg name="day" id="k5u2o187svcvu4xkcn6f" type="number"></arg></mutation><field name="function_name">getDayOfWeek</field><comment pinned="false" h="80" w="160">Date string converters</comment><value name="k5u2o187svcvu4xkcn6f"><block type="argument_reporter_number" id="9e[7Z77wkB!g|N(k0%*M" deletable="false"><field name="VALUE">day</field></block></value><statement name="STACK"><block type="function_return" id=":W|[x7?6LiA/+23d-*.("><mutation xmlns="http://www.w3.org/1999/xhtml" no_return_value="false"></mutation><value name="RETURN_VALUE"><shadow type="math_number" id="~rL3ARRFt$p!-^,C?N9="><field name="NUM">0</field></shadow><block type="lists_index_get" id="VRcQv2c-@h{}$#P3|44X"><value name="LIST"><block type="lists_create_with" id="{kBGbw]`E1(,r=NXZLbJ" inline="false"><mutation items="7" horizontalafter="3"></mutation><value name="ADD0"><shadow type="text" id="S3plcA|7X8,:b?MYIeKP"><field name="TEXT">Sunday</field></shadow></value><value name="ADD1"><shadow type="text" id="RON^Cdjw`bGW+(/2hki#"><field name="TEXT">Monday</field></shadow></value><va