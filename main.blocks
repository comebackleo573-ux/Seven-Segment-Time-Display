ty">SevenSegDigit.x@set</field><value name="myDigit"><block type="variables_get" id="E+[4@L0TteZPLWd.r|l2"><field name="VAR" id="q#PuzE#h6y$vCtT2s0ne">AMPM</field></block></value><value name="value"><shadow type="math_number" id="b3;7#1*m`_OVl:M@@;*N"><field name="NUM">-50</field></shadow></value><next><block type="SevenSegDigit_blockCombine_change" id="Tg@^|Joey9irBV.HW.D_"><field name="property">SevenSegDigit.y@set</field><value name="myDigit"><block type="variables_get" id="Z0VFw!rqXx(-,!K,7#z#"><field name="VAR" id="q#PuzE#h6y$vCtT2s0ne">AMPM</field></block></value><value name="value"><shadow type="math_number" id="kZ:gUsdA_?WQ0DP7lGaK"><field name="NUM">-8</field></shadow></value><next><block type="typescript_statement" id="bIZrB!)XN;9Vw++o[NFW"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="let Military_Time_Boolem = false" numlines="1" declaredvars="Military_Time_Boolem"></mutation><next><block type="typescript_statement" id="lAp;(?@7f77_M(9!LZhc"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="let Date_Boolem = false" numlines="1" declaredvars="Date_Boolem"></mutation><next><block type="typescript_statement" id="v]U}^MFsg3JmBw^dS-?s"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="game.onShade(() =&gt; {" line1="    const time = browserEvents.currentTime();" line2="    const rawHours = browserEvents.getHours(time);" line3="    const minutes = browserEvents.getMinutes(time);" line4="    const seconds = browserEvents.getSeconds(time);" line5="" line6="    if (Military_Time_Boolem) {" line7="        Hour.count = rawHours;" line8="        AMPM.setDigitAlpha(SegmentCharacter.E);" line9="    } else {" line10="        const hours12 = rawHours % 12 === 0 ? 12 : rawHours % 12;" line11="        Hour.count = hours12;" line12="" line13="        if (rawHours &gt;= 12) {" line14="            AMPM.setDigitAlpha(SegmentCharacter.P); // Displays &quot;P&quot;" line15="        } else {" line16="            AMPM.setDigitAlpha(SegmentCharacter.A); // Displays &quot;A&quot;" line17="        }" line18="    }" line19="" line20="    Minutes.count = minutes;" line21="    Seconds.count = seconds;" line22="" line23="    if (!Date_Boolem) {" line24="        const dayName = getDayOfWeek(browserEvents.getDayOfWeek(time));" line25="        const monthName = getMonth(browserEvents.getMonth(time));" line26="        const dateNum = formatNumber(browserEvents.getDayOfMonth(time));" line27="        const yearNum = browserEvents.getYear(time) + &quot;&quot;;" line28="" line29="        screen.printCenter(`${dayName}, ${monthName} ${dateNum}`, 95, 15);" line30="        screen.printCenter(yearNum, 107, 15);" line31="    }" line32="});" numlines="33"></mutation></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></statement></block><block type="keyonevent" id="8L]jW?LHapM7R4;0(`}@" x="931" y="20"><field name="button">controller.B</field><field name="event">ControllerButtonEvent.Pressed</field><statement name="HANDLER"><block type="variables_set" id="S1:96SgMgTLRpBNR$rfv"><field name="VAR" id="f4r7x?E*=+e#Qo%Mvk5h">Settings_Menu</field><value name="VALUE"><shadow type="math_number" id="]5eFls*lQ!;8sSfi:7ph"><field name="NUM">0</field></shadow><block type="mini_menu_show_menu" id="*qTB}1!6g$vzV(GmkrbW"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="2" _input_init="true"></mutation><value name="item1"><shadow type="mini_menu_create_menu_item" id="y?J-Q%Mo2QCN]G.YCip("><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="1" _input_init="true"></mutation><value name="text"><shadow type="text" id="]L7nZNfft9TRqcQ?0o=y"><field name="TEXT">Military Time </field></shadow></value><value name="image"><shadow type="screen_image_picker" id="3T2UB@6MioCiou,K~vl("><field name="img">img`
